  "private": true,
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "clsx": "2.1.1",
    "geist": "1.7.2",
    "motion": "13.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-plugin-singlefile": "2.3.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
